module tb_sync_fifo;

  reg clk, rst;
  reg wr_en, rd_en;
  reg [3:0] data_in;

  wire [3:0] data_out;
  wire full, empty;

  integer i;

  
  sync_fifo uut (
    .clk(clk),
    .rst(rst),
    .wr_en(wr_en),
    .rd_en(rd_en),
    .data_in(data_in),
    .data_out(data_out),
    .full(full),
    .empty(empty)
  );

  
  always #5 clk = ~clk;

  initial begin
    clk = 0;
    rst = 1;
    wr_en = 0;
    rd_en = 0;

    #10 rst = 0;

    
    for (i = 0; i < 4; i = i + 1) begin
      @(posedge clk);
      wr_en = 1;
      data_in = i;
      $display("WRITE: data_in = %0d", data_in);
    end

    @(posedge clk);
    wr_en = 0;

    
    for (i = 0; i < 4; i = i + 1) begin
      @(posedge clk);
      rd_en = 1;

      @(posedge clk); 
      $display("READ: data_out = %0d", data_out);
    end

    rd_en = 0;

    #20 $finish;
  end

endmodule
