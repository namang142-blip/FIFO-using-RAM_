
module tb_sync_fifo;

reg clk;
reg rst;
reg wr_en;
reg rd_en;
reg [3:0] din;
wire [3:0] dout;
wire full;
wire empty;

integer i;

sync_fifo uut(
    .clk(clk),
    .rst(rst),
    .wr_en(wr_en),
    .rd_en(rd_en),
    .din(din),
    .dout(dout),
    .full(full),
    .empty(empty)
);

initial begin
    clk = 1'b0;
    forever #5 clk = ~clk;
end

initial begin
    rst = 1'b1;
    wr_en = 1'b0;
    rd_en = 1'b0;
    din = 4'b0000;

    #12 rst = 1'b0;

    for (i = 0; i < 4; i = i + 1) begin
        @(negedge clk);
        wr_en = 1'b1;
        rd_en = 1'b0;
        din = i + 1;
    end

    @(negedge clk);
    wr_en = 1'b1;
    rd_en = 1'b0;
    din = 4'b1111;

    @(negedge clk);
    wr_en = 1'b0;
    rd_en = 1'b1;

    for (i = 0; i < 4; i = i + 1) begin
        @(negedge clk);
        wr_en = 1'b0;
        rd_en = 1'b1;
    end

    @(negedge clk);
    wr_en = 1'b0;
    rd_en = 1'b0;

    #20 rst = 1'b1;
    #10 rst = 1'b0;

    #20 $finish;
end

always @(posedge clk) begin
    $display("time=%0t rst=%b wr_en=%b rd_en=%b din=%b dout=%b full=%b empty=%b",
             $time, rst, wr_en, rd_en, din, dout, full, empty);
end

endmodule
