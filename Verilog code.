module sync_fifo(
input clk, rst,
input wr_en, rd_en,
input [3:0] din,
output reg[3:0] dout,
output reg full,
output reg empty);

reg[3:0]mem[0:3];
reg[2:0]wr_ptr,rd_ptr;

always@(posedge clk or posedge rst)begin
if(rst)begin
wr_ptr <= 0;
rd_ptr <= 0;
full <= 0;
empty <= 1;
dout <= 0;
end
else begin
if(wr_en && !full)begin
mem[wr_ptr]<=din;
wr_ptr<=wr_ptr+1;
end
if(rd_en && !empty)begin
dout<=mem[rd_ptr];
rd_ptr<=rd_ptr+1;
end
if(wr_ptr==rd_ptr)
empty<=1;
else
empty<=0;
if((wr_ptr+1)%4==rd_ptr)
full<=1;
else
full<=0;
end
end
endmodule
